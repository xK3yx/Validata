# Copy to .env and fill in your keys.

# Required: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: grounds reports in live web results and enables competitor lookup.
# https://serper.dev/api-keys
SERPER_API_KEY=

# Groq retires models over time; change this if calls fail with model_not_found.
GROQ_MODEL=openai/gpt-oss-120b

PORT=3001

# Comma-separated frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Free validations per browser per day, and AI requests per IP per hour
DAILY_FREE_LIMIT=5
AI_RATE_LIMIT_PER_HOUR=30

# Set to 1 when running behind a reverse proxy so rate limits see real client IPs
# TRUST_PROXY=1

{
  "name": "validata",
  "version": "1.1.0",
  "description": "AI SaaS Idea Validator",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "server:node": "node server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
